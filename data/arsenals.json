  },
  "abstraction": {
    "note": "A game cannot have 5,420 individually addressable warheads. Each power's cited numbers are grouped into a small number of launch units. Silo groups and boats are composites, not real installations. Warheads per unit are chosen so that the sum of all units approximates the cited deployed-strategic figure for states that deploy, and the military stockpile for states that do not.",
    "unit_kinds": {
      "silo": "Land-based group. Launches on the tick ordered. Visible to sensors. Destroyable by a FORCES strike.",
      "sub": "Sea-based boat. One tick of spin-up before launch. Position hidden until it launches. Not destroyable in V1."
    }
  },

{
  "name": "brink-mcp",
  "version": "0.1.0",
  "description": "A deterministic nuclear escalation game playable by humans or AI agents. Real arsenals, real geography, one decision at a time.",
  "license": "MIT",
  "author": "Javier Ponz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "brink-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "data",
    "scenarios",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "mcp": "node dist/mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponzgpt/brink.git"
  },
  "homepage": "https://brink.technoir.cloud",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "game",
    "agent",
    "benchmark",
    "wargame",
    "escalation"
  ]
}
